#
# Recovery fstab for ZTE P725A02 (lito / msm-4.19, Android 11 vendor).
#
# Every device path and flag below is taken from the STOCK fstab that ships in
# the stock boot ramdisk (stock/boot/ramdisk, file fstab.qcom) and from the
# stock recovery image's own /system/etc/recovery.fstab.  Nothing here is
# invented; open questions are called out in comments.
#
# Device node facts:
#   bootdevice  /dev/block/platform/soc/1d84000.ufshc (UFS)
#   the stock fstab uses the /dev/block/bootdevice/by-name/<name> symlinks
#   A/B: slot-selected partitions are <name>_a / <name>_b, hence slotselect
#
#<src>                                                  <mnt_point>            <type>  <mnt_flags and options>                 <fs_mgr_flags>

# ---- Logical partitions inside super (slot selected, AVB via vbmeta_system)
system                                                  /system                ext4    ro,barrier=1                             wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system_ext                                              /system_ext            ext4    ro,barrier=1                             wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,optional
product                                                 /product               ext4    ro,barrier=1,discard                     wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
vendor                                                  /vendor                ext4    ro,barrier=1,discard                     wait,slotselect,avb,logical,first_stage_mount
odm                                                     /odm                   ext4    ro,barrier=1,discard                     wait,slotselect,avb,logical,first_stage_mount,optional

# ---- Metadata (FBE key storage, wrapped keys via keymaster)
/dev/block/bootdevice/by-name/metadata                      /metadata              ext4    noatime,nosuid,nodev,discard             wait,check,formattable,wrappedkey

# ---- Userdata: FBE + ICE + wrappedkey，逐项与原厂 recovery.fstab 对齐。
# 与原厂 recovery 镜像自带的 /system/etc/recovery.fstab（同机、已知可用）比对后修正两处偏差：
#   * 挂载选项不含 inlinecrypt —— 只有原厂 *boot* 的 fstab.qcom 才带它（正常启动时 ICE
#     密钥已由 keymaster 提供）；recovery 没有 ICE 密钥句柄，不应请求 inline-crypt 语义。
#   * fs_mgr 标志恢复 sysfs_path=/sys/devices/platform/soc/1d84000.ufshc（UFS 控制器），
#     原厂 recovery.fstab 正是这么写的（旧注释声称取了该值，但行里没有，属注释与行不符）。
# 重要限制（不要误判为本次修正能解决）：/data 是 FBE + ICE + wrappedkey，密钥经 keymaster
# 包在 /metadata/vold/metadata_encryption；本镜像 TW_INCLUDE_CRYPTO := false 且未带
# qseecom/keymaster 库与服务，因此无法解密，挂载失败属已知限制；任何情况下都不要格式化
# userdata（唯一能真正修好 /data 的路径是补齐原厂 crypto blobs 并实机验证）。
/dev/block/bootdevice/by-name/userdata                      /data                  f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier latemount,wait,check,formattable,fileencryption=ice,wrappedkey,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128M,sysfs_path=/sys/devices/platform/soc/1d84000.ufshc,checkpoint=fs

# ---- Persistent firmware / properties
/dev/block/bootdevice/by-name/persist                       /mnt/vendor/persist    ext4    noatime,nosuid,nodev,barrier=1           wait,check,formattable

# ---- Misc control block
/dev/block/bootdevice/by-name/misc                          /misc                  emmc    defaults                                 defaults

# ---- Slot-selected firmware partitions (read-only mount, flashable via twrp.flags)
/dev/block/bootdevice/by-name/modem                         /vendor/firmware_mnt   vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337 wait,slotselect
/dev/block/bootdevice/by-name/dsp                           /vendor/dsp            ext4    ro,nosuid,nodev,barrier=1                wait,slotselect
/dev/block/bootdevice/by-name/bluetooth                     /vendor/bt_firmware    vfat    ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337 wait,slotselect

# ---- Log storage
/dev/block/bootdevice/by-name/logdump                       /logdump               ext4    noatime,nosuid,nodev,barrier=1,discard   wait,formattable

# ---- Removable storage
# The UFS LUNs already occupy sda..sd*; external media (UFS card slot and
# USB-OTG) are handled through twrp.flags rather than an fstab entry.
