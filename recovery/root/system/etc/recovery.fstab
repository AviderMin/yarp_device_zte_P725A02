#
# ZTE P725A02 (lito / msm-4.19, Android 11 vendor) recovery fstab。
# 全部路径与标志取自原厂 fstab（stock/boot/ramdisk/fstab.qcom 与原厂 recovery 镜像）。
# 详细依据见根目录 README.md「设备树逐文件说明 / recovery.fstab」。
#
# 设备节点：bootdevice = /dev/block/platform/soc/1d84000.ufshc（UFS）；
# by-name 符号链接；A/B 分区为 <name>_a/<name>_b，故需 slotselect。
#
# 本文件是唯一来源：BoardConfig.mk 已打开 TW_SKIP_ADDITIONAL_FSTAB，
# 厂商 additional.fstab 不再参与，/data 与 /metadata 由这里定义（v2 加密选项格式）。
# 注意：本文件里所有挂载点都必须是一级路径——Get_Root_Path() 只保留第一段。
#
#<src>                                                  <mnt_point>            <type>  <mnt_flags and options>                 <fs_mgr_flags>

# ---- super 内的逻辑分区（按槽位选择，AVB 经 vbmeta_system）
# super 里只有 system/product/vendor；system_ext 与 odm 不是独立分区，不能写。
system                                                  /system                ext4    ro,barrier=1                             wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
product                                                 /product               ext4    ro,barrier=1,discard                     wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
vendor                                                  /vendor                ext4    ro,barrier=1,discard                     wait,slotselect,avb,logical,first_stage_mount

# ---- Metadata：FBE 密钥存储，包装密钥经 keymaster
/dev/block/bootdevice/by-name/metadata                      /metadata              ext4    noatime,nosuid,nodev,discard             wait,check,formattable,wrappedkey

# ---- Userdata：FBE + ICE + wrappedkey，v2 格式 + iv_offset（见 README t12）
# :v2 显式钉版本。iv_offset 由 ro.crypto.metadata.iv_offset 提供，
# 值取自原厂自己 dm 表里的 25874496 —— Android 16 的 libdm 把它硬编码成 0 丢掉了。
# 绝对不要格式化 /data：先取证再判断，依据见 README。
/dev/block/bootdevice/by-name/userdata                      /data                  f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt latemount,wait,check,formattable,quota,reservedsize=128M,fileencryption=ice:aes-256-cts:v2,wrappedkey,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts:wrappedkey_v0,checkpoint=fs

# ---- 持久化固件/属性
# 必须是【一级】挂载点：Get_Root_Path() 只保留路径第一段，
# /mnt/vendor/persist 会被截成 /mnt 而永远找不到（见 README t13）。
/dev/block/bootdevice/by-name/persist                       /persist               ext4    noatime,nosuid,nodev,barrier=1           wait,check,formattable

# ---- 控制块
/dev/block/bootdevice/by-name/misc                          /misc                  emmc    defaults                                 defaults

# ---- 已删除：/vendor/firmware_mnt、/vendor/dsp、/vendor/bt_firmware（R2 修复）
# 它们是三级挂载点，会被 Get_Root_Path() 截成 /vendor 而丢弃；已移到 twrp.flags。
# 回归检查：本文件不得再出现这三个挂载点。

# ---- 日志存储
/dev/block/bootdevice/by-name/logdump                       /logdump               ext4    noatime,nosuid,nodev,barrier=1,discard   wait,formattable

# ---- 可移动存储：UFS LUN 已占用 sda..sd*，外置介质由 twrp.flags 处理。
