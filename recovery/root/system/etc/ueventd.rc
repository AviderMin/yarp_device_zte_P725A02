# ueventd permissions for ZTE P725A02 recovery.
#
# Loaded first in recovery mode: system/core/init/ueventd.cpp:301/315 parses
# /system/etc/ueventd.rc and /vendor/etc/ueventd.rc, so this file has to live at
# system/etc/ueventd.rc in the recovery ramdisk.
#
# CORRECTION (verified against the stock recovery image, not assumed): the
# vendor recovery ramdisk at ~/workdir/twrpgen/recovery.img DOES ship its own
# /system/etc/ueventd.rc (2824 bytes, extracted and read) together with
# /system/bin/ueventd, and the stock vendor partition likewise ships
# /vendor/ueventd.rc.  So this file is NOT new and does not replace anything:
# ueventd parses the recovery ramdisk's /system/etc/ueventd.rc first and then
# the stock vendor's /vendor/ueventd.rc, and this file only ADDS deltas.
#
# What the vendor copies already cover (therefore NOT repeated here):
#   /dev/null /dev/zero /dev/full /dev/ptmx /dev/tty /dev/random /dev/urandom
#   /dev/hw_random /dev/ashmem* /dev/binder /dev/hwbinder /dev/vndbinder
#   /dev/dri/* /dev/graphics/* /dev/input/* /dev/snd/* /dev/bus/usb/*
#   subsystem graphics|drm|input|sound, firmware_directories, socket rcvbuf
# Deliberate additions, each with a reason:
#   - /dev/ion    : display/ION path on msm-4.19 (not covered by the vendor list)
#   - /dev/qseecom: only useful once the crypto stack is enabled; harmless now
#   - backlight   : the stock recovery writes this sysfs node at "on init" as
#                   root; pinned explicitly so the behaviour stays deterministic
#   - UFS block   : bootdevice 1d84000.ufshc by-name links (vendor list has none)

/dev/ion                  0664   system     system
/dev/qseecom              0660   system     drmrpc

# Panel backlight: the stock recovery ramdisk writes
# /sys/class/backlight/panel0-backlight/brightness at "on init", i.e. before
# ueventd has finished applying the vendor's sysfs permissions.  Granting the
# write explicitly here keeps that behaviour deterministic.
/sys/class/backlight/panel0-backlight/brightness     0664   system     system

# UFS (bootdevice 1d84000.ufshc) and its by-name links
/dev/block/sd*            0660   root       system
/dev/block/platform/soc/1d84000.ufshc/by-name/*   0660   root   system