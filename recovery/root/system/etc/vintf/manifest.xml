<!--
    recovery ramdisk 的 VINTF framework manifest。

    为什么需要：system/hwservicemanager/service.cpp:150-160 自检
    android.hidl.manager@1.2::IServiceManager/default 能否解析出 transport，
    解析不到就把 hwservicemanager.disabled 置 true 并进入 sleep(10) 死循环；
    片段目录（system/etc/vintf/manifest/）只在主 manifest 解析成功时才被读，
    所以补片段无效，必须补主 manifest。

    四条：android.hidl.manager 必须是 1.2（ServiceManager::descriptor 是 1.2，
    且声明版本需 >= 查询版本）；keymaster 4.0 与 gatekeeper 1.0 是注册闸门要求
    （PRODUCT_ENFORCE_VINTF_MANIFEST 恒为 true）。

    全部写在 framework 一份里：/vendor 是 TWRP 会挂上又卸下的地方。
    完整推导见根目录 README.md「设备树逐文件说明 / vintf/manifest.xml」。

    注意：本注释内不得出现连续两个连字符（XML 规范禁止）。
-->
<manifest version="1.0" type="framework">
    <hal format="hidl">
        <name>android.hidl.manager</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IServiceManager</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hidl.token</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>ITokenManager</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.keymaster</name>
        <transport>hwbinder</transport>
        <version>4.0</version>
        <interface>
            <name>IKeymasterDevice</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.gatekeeper</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IGatekeeper</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>
