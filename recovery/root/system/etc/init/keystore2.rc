# keystore2 服务定义：设备树覆盖 bootable/recovery/etc/init/keystore2.rc。
# 完整理由与残留空档见根目录 README.md「设备树逐文件说明 / keystore2.rc」。
# 只改触发条件，service 定义与平台版本逐字节相同。

# 第一次启动必然输给一次性查询竞态，故拆掉 fatal 重启升级（recovery 里计数无上限）
on early-init
    setprop init.svc_debug.no_fatal.keystore2 true

# 原平台从 on late-init 启动，与必须从 ramdisk 拉起的 keymaster HAL 无关
on property:init.svc.keymaster-4-0=running
    start keystore2

service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user root
    group keystore readproc log
    task_profiles ProcessCapacityHigh
    rlimit memlock unlimited unlimited
    critical window=0
    seclabel u:r:recovery:s0
