# TWRP 额外分区表，用于中兴 P725A02。
# 完整依据、证据分级与回归检查见根目录 README.md「设备树逐文件说明 / twrp.flags」。
#
# 格式：<挂载点> <文件系统> <设备> [设备2] flags=...
#   - 第 4 列只有以 / 开头才被收下；解析器不认双引号。
#   - display= 里绝不能有空格，否则其后所有标志被静默丢弃。
#   - 无独立的 mount 选项列；挂载选项只能经 flags= 里的 fsflags= 传。
#   - 不要写 image=（无此标志），也不要写 primary（本机是 A/B）。

# ---- 已证实（原厂 9008 包分区表 + 原厂 recovery fstab 均有）
/boot                emmc    /dev/block/by-name/boot                     flags=slotselect;display="Boot";backup=1;flashimg=1
/recovery            emmc    /dev/block/by-name/recovery                 flags=slotselect;display="Recovery";backup=1;flashimg=1
/dtbo                emmc    /dev/block/by-name/dtbo                     flags=slotselect;display="DTBO";backup=1;flashimg=1
/vbmeta              emmc    /dev/block/by-name/vbmeta                   flags=slotselect;display="VBMeta";backup=1;flashimg=1
/vbmeta_system       emmc    /dev/block/by-name/vbmeta_system            flags=slotselect;display="VBMeta_System";backup=1;flashimg=1
/apdp                emmc    /dev/block/by-name/apdp                     flags=display="APDP";backup=1;flashimg=1

# ---- 调制解调器固件族（dsp/bluetooth 作为 /modem 的子分区）
/modem               emmc    /dev/block/by-name/modem                    flags=slotselect;display="Modem";backup=1;flashimg=1
/dsp                 emmc    /dev/block/by-name/dsp                      flags=slotselect;backup=1;subpartitionof=/modem
/bluetooth           emmc    /dev/block/by-name/bluetooth                flags=slotselect;backup=1;subpartitionof=/modem

# ---- 原厂 recovery fstab 有、已实机核对节点存在（frp/ztecfg/fsg/fsc/modemst1/modemst2）
# D1：原 /msadp 行已删除（本机 GPT 没有 msadp，是幽灵条目）。回归检查：不得再出现。
/persistent          emmc    /dev/block/by-name/frp                      flags=display="Persistent_frp";backup=1;flashimg=1
/ztecfg              emmc    /dev/block/by-name/ztecfg                    flags=display="ZTECFG";backup=1;flashimg=1
/fsg                 emmc    /dev/block/by-name/fsg                      flags=display="FSG";backup=1;flashimg=1
/fsc                 emmc    /dev/block/by-name/fsc                      flags=display="FSC";backup=1;flashimg=1
/modemst1            emmc    /dev/block/by-name/modemst1                 flags=display="Modem_ST1";backup=1;flashimg=1
/modemst2            emmc    /dev/block/by-name/modemst2                 flags=display="Modem_ST2";backup=1;flashimg=1

# ---- 固件分区（R2 + B1 修复）
# 原在 recovery.fstab 的 /vendor/firmware_mnt 等三级挂载点会被 TWRP 丢弃，
# 改为一级挂载点并标为 /modem 子分区；fsflags= 恢复原厂的 ro 与 SELinux 上下文。
/firmware_mnt        vfat    /dev/block/bootdevice/by-name/modem         flags=slotselect;display="firmware_mnt";backup=1;flashimg=1;subpartitionof=/modem;fsflags=ro,shortname=lower,uid=0,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0
/dsp_firmware        ext4    /dev/block/bootdevice/by-name/dsp           flags=slotselect;display="dsp_firmware";backup=1;flashimg=1;subpartitionof=/modem;fsflags=ro,nosuid,nodev,barrier=1
/bt_firmware         vfat    /dev/block/bootdevice/by-name/bluetooth     flags=slotselect;display="bt_firmware";backup=1;flashimg=1;subpartitionof=/modem;fsflags=ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0

# ---- 可移动存储（B2 未修好：auto 不是通配符，见 README）
# 不得把 /devices/... 写成第 1 列，也不得再出现 1da4000.ufshc_card。
/usb_otg             vfat    auto                                       flags=display="USB-OTG";storage;wipeingui;removable
/sdcard1             vfat    auto                                       flags=display="MicroSD";storage;wipeingui;removable
