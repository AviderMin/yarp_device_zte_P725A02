#
# Recovery init for ZTE P725A02 (lito, msm-4.19).
#
# This file is the ONE piece kept from the generator template: it already
# matched the stock recovery ramdisk's own init.recovery.qcom.rc byte for byte
# (same backlight write, same USB controller property, same bootdevice symlink).
# Everything else in recovery/root was restructured to the paths TWRP 16
# actually reads:
#   system/etc/recovery.fstab   (TARGET_RECOVERY_FSTAB, copied by core/Makefile)
#   system/etc/twrp.flags       (read as /etc/twrp.flags)
#   system/etc/ueventd.rc       (first path ueventd parses in recovery mode)
#   init.recovery.usb.rc        (USB gadget + ADB/MTP triggers; overrides the
#                                upstream file of the same name at the ramdisk root)

# NOTE on paths: TWRP's own bootable/recovery/etc/init.rc already does
#   import /init.recovery.${ro.hardware}.rc   (-> this file, ro.hardware=qcom)
#   symlink /system/etc /etc                  (so /etc/twrp.fstab,
#                                              /etc/recovery.fstab and
#                                              /etc/twrp.flags resolve)
#   import /init.recovery.usb.rc              (USB gadget setup)
# This device tree DOES override that last file: recovery/root/init.recovery.usb.rc
# lands at the ramdisk root and replaces upstream's bootable/recovery/etc/
# init.recovery.usb.rc (verified on device: /init.recovery.usb.rc md5
# 8bf681c1486ed9c88efd772b66879a14 == the repo file).  The configfs mtp,adb branch
# that upstream init.rc does not provide lives there - see that file's header.
# Only the /system/etc -> /etc symlink is not repeated here.

on init
    # The stock recovery ramdisk does exactly this (200).
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    # The stock recovery keeps this commented out because the controller string
    # already ends in ".dwc3" and sys.usb.controller is consumed verbatim:
    #   ro.boot.usbcontroller=a600000.dwc3   (stock boot.img-cmdline)
    # so /sys/class/udc/${ro.boot.usbcontroller} resolves without an extra
    # ".dwc3" suffix.  Left disabled on purpose.
    # write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

# ---------------------------------------------------------------------------
# Qualcomm secure services required to unwrap the metadata-encryption key.
#
# TWRP creates the logical vendor mapper before setting
# twrp.super.symlinks_created. Mount vendor at that point, then start the stock
# QSEECom and Keymaster 4.0 services. Without them metadataDecrypt() fails and
# TWRP shows its generic password page even when Android has no screen lock.
on property:twrp.super.symlinks_created=true
    mkdir /vendor 0755 root root
    wait /dev/block/mapper/vendor${ro.boot.slot_suffix}
    mount ext4 /dev/block/mapper/vendor${ro.boot.slot_suffix} /vendor ro
    start vendor.qseecomd
    start keymaster-4-0

service vendor.qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    disabled
    seclabel u:r:recovery:s0

service keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service-qti
    class early_hal
    user system
    group system drmrpc
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    disabled
    seclabel u:r:recovery:s0