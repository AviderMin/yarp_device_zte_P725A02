# ZTE P725A02 (lito, msm-4.19) recovery init。
# 详细说明见根目录 README.md「设备树逐文件说明 / recovery/root/init.recovery.qcom.rc」。

on early-init
    # 加密服务跑在 ramdisk 里，不依赖会被 TWRP 卸掉的 /vendor
    mkdir /vendor_ramdisk 0755 root root
    # 构建期无法给这三个二进制加上可执行位，只能在这里补
    chmod 0755 /vendor_ramdisk/bin/qseecomd
    chmod 0755 /vendor_ramdisk/bin/hw/android.hardware.keymaster@4.0-service-qti
    chmod 0755 /vendor_ramdisk/bin/hw/android.hardware.gatekeeper@1.0-service-qti
    # libkeymasterdeviceutils.so 硬编码从这个路径打开 keymaster TA
    mkdir /vendor/firmware_mnt 0755 root root
    mkdir /vendor/firmware_mnt/image 0755 root root
    # bind mount 而非拷贝：真实的 vendor 分区挂上来也遮不住它
    mkdir /vendor/bin 0755 root root
    mkdir /vendor/lib64 0755 root root
    mkdir /vendor/lib64/hw 0755 root root
    mount none /vendor_ramdisk/bin /vendor/bin bind
    mount none /vendor_ramdisk/lib64 /vendor/lib64 bind
    mount none /vendor_ramdisk/lib64/hw /vendor/lib64/hw bind
    # 让内核 firmware loader 也找得到 keymaster trustlet
    write /sys/module/firmware_class/parameters/path /vendor/firmware_mnt/image

on init
    # 与原厂 recovery ramdisk 一致
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    # 原厂同样把下面这条注释掉：controller 串已含 .dwc3，无需再加后缀
    # write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # 提前挂 /metadata：包装密钥在里面，且 Key_Directory 查找会被截断成 /metadata
    wait /dev/block/bootdevice/by-name/metadata 10
    mkdir /metadata 0755 root root
    mount ext4 /dev/block/bootdevice/by-name/metadata /metadata noatime,nosuid,nodev,discard

    # qseecomd 的 RPMB/SSD 监听器需要 /dev/qseecom 与 ssd 链接，否则不注册任何东西
    wait /dev/qseecom 10
    wait /dev/block/bootdevice/by-name/ssd 10
    start vendor.qseecomd

# HAL 闸门：qseecomd 真正 running + 监听器已注册 + hwservicemanager 就绪
on property:init.svc.vendor.qseecomd=running && property:vendor.sys.listeners.registered=true && property:hwservicemanager.ready=true
    start keymaster-4-0
    start gatekeeper-1-0

service vendor.qseecomd /vendor_ramdisk/bin/qseecomd
    class core
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor_ramdisk/lib64:/vendor_ramdisk/lib64/hw:/vendor/lib64:/vendor/lib64/hw:/system/lib64
    disabled
    seclabel u:r:recovery:s0

# keystore2 靠它取 TRUSTED_ENVIRONMENT，是唯一能导出包装存储密钥的组件
service keymaster-4-0 /vendor_ramdisk/bin/hw/android.hardware.keymaster@4.0-service-qti
    class early_hal
    user system
    group system drmrpc
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    setenv LD_LIBRARY_PATH /vendor_ramdisk/lib64:/vendor_ramdisk/lib64/hw:/vendor/lib64:/vendor/lib64/hw:/system/lib64
    disabled
    seclabel u:r:recovery:s0

# 原厂 vendor vintf manifest 声明了它；与 keymaster 共用 QSEECom，闸门相同
service gatekeeper-1-0 /vendor_ramdisk/bin/hw/android.hardware.gatekeeper@1.0-service-qti
    class early_hal
    user system
    group system drmrpc
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    setenv LD_LIBRARY_PATH /vendor_ramdisk/lib64:/vendor_ramdisk/lib64/hw:/vendor/lib64:/vendor/lib64/hw:/system/lib64
    disabled
    seclabel u:r:recovery:s0

# keystore2 刻意不在这里启动：见 recovery/root/system/etc/init/keystore2.rc
# 本文件绝不能再 start keystore2。
