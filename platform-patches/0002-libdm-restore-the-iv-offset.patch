diff --git a/fs_mgr/libdm/dm_target.cpp b/fs_mgr/libdm/dm_target.cpp
index b5cc9aa..f6db398 100644
--- a/fs_mgr/libdm/dm_target.cpp
+++ b/fs_mgr/libdm/dm_target.cpp
@@ -268,7 +268,7 @@ std::string DmTargetDefaultKey::GetParameterString() const {
     argv.emplace_back(cipher_);
     argv.emplace_back(key_);
     if (!use_legacy_options_format_) {
-        argv.emplace_back("0");  // iv_offset
+        argv.emplace_back(std::to_string(iv_offset_));  // iv_offset
     }
     argv.emplace_back(blockdev_);
     argv.push_back(std::to_string(start_sector_));
@@ -281,12 +281,29 @@ std::string DmTargetDefaultKey::GetParameterString() const {
         extra_argv.emplace_back("allow_discards");
         extra_argv.emplace_back("sector_size:4096");
         extra_argv.emplace_back("iv_large_sectors");
-        if (is_hw_wrapped_) extra_argv.emplace_back("wrappedkey_v0");
     }
+    // wrappedkey_v0 tells the kernel that the key argument is a hardware-wrapped
+    // blob rather than raw key material of the cipher's key size, and the kernel
+    // rejects the wrong one with "default-key: Invalid keysize".  It is required
+    // on BOTH option formats: a device that selects the legacy format (v1 fstab,
+    // "fileencryption=ice") while also using a wrapped metadata key -- which is
+    // what fs_mgr_flags.wrapped_key on the /metadata entry means, see
+    // is_metadata_wrapped_key_supported() in system/vold/FsCrypt.cpp -- still
+    // hands the kernel the output of exportWrappedStorageKey().  Emitting it only
+    // in the non-legacy branch, as upstream does, drops the marker on exactly
+    // that combination.
+    if (is_hw_wrapped_) extra_argv.emplace_back("wrappedkey_v0");
     if (!extra_argv.empty()) {
         argv.emplace_back(std::to_string(extra_argv.size()));
         argv.insert(argv.end(), extra_argv.begin(), extra_argv.end());
     }
+    // TEMPORARY INSTRUMENTATION: one line per default-key table, no key material.
+    // Remove once the ZTE P725A02 metadata decryption is confirmed working; see
+    // platform-patches/ in the device tree for the context.
+    LOG(INFO) << "default-key: legacy=" << use_legacy_options_format_
+              << " hw_wrapped=" << is_hw_wrapped_ << " set_dun=" << set_dun_
+              << " key_len=" << key_.size() << " argc=" << argv.size()
+              << " extra=" << (extra_argv.empty() ? "-" : android::base::Join(extra_argv, ","));
     return android::base::Join(argv, " ");
 }
 
diff --git a/fs_mgr/libdm/include/libdm/dm_target.h b/fs_mgr/libdm/include/libdm/dm_target.h
index c49fc5e..2ee9a72 100644
--- a/fs_mgr/libdm/include/libdm/dm_target.h
+++ b/fs_mgr/libdm/include/libdm/dm_target.h
@@ -315,6 +315,7 @@ class DmTargetDefaultKey final : public DmTarget {
     void SetUseLegacyOptionsFormat() { use_legacy_options_format_ = true; }
     void SetSetDun() { set_dun_ = true; }
     void SetWrappedKeyV0() { is_hw_wrapped_ = true; }
+    void SetIvOffset(uint64_t o) { iv_offset_ = o; }
 
   private:
     inline static const std::string kName = "default-key";
@@ -326,6 +327,9 @@ class DmTargetDefaultKey final : public DmTarget {
     bool use_legacy_options_format_ = false;
     bool set_dun_ = false;
     bool is_hw_wrapped_ = false;
+    // Offsets the IV derivation.  Upstream Android 11 took this from the
+    // constructor; Android 16 hardcodes 0 in GetParameterString().
+    uint64_t iv_offset_ = 0;
 };
 
 class DmTargetUser final : public DmTarget {
diff --git a/MetadataCrypt.cpp b/MetadataCrypt.cpp
index bc2e7ea..47f6a43 100644
--- a/MetadataCrypt.cpp
+++ b/MetadataCrypt.cpp
@@ -176,6 +176,12 @@ static bool create_crypto_blk_dev(const std::string& dm_name, const std::string&
     if (options.use_legacy_options_format) target->SetUseLegacyOptionsFormat();
     if (options.set_dun) target->SetSetDun();
     if (options.use_hw_wrapped_key) target->SetWrappedKeyV0();
+    // TEMPORARY (debug): the stock Android 11 vold passed a non-zero iv_offset
+    // here and Android 16's libdm dropped the parameter, hardcoding 0 instead.
+    // Reading it from the stock device's own dm table is the whole point of
+    // this change; see platform-patches/ in the device tree.
+    target->SetIvOffset(
+            android::base::GetUintProperty<uint32_t>("ro.crypto.metadata.iv_offset", 0));
 
     DmTable table;
     table.AddTarget(std::move(target));
